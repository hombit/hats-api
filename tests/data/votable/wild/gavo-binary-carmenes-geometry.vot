Note that we only publish spectra that were actually used in time
series. Also, note that positions and object names from the headers of
the spectra are unreliable.</DESCRIPTION><FIELD ID="ssa_pubDID" arraysize="*" datatype="char" name="ssa_pubDID" ucd="meta.ref.ivoid" utype="ssa:Curation.PublisherDID"><DESCRIPTION>Dataset identifier assigned by the publisher</DESCRIPTION></FIELD><FIELD ID="ssa_cdate" arraysize="*" datatype="char" name="ssa_cdate" ucd="time;meta.dataset" utype="ssa:DataID.Date" xtype="timestamp"><DESCRIPTION>Processing/Creation date</DESCRIPTION><VALUES null=""></VALUES></FIELD><FIELD ID="ssa_targname" arraysize="*" datatype="char" name="ssa_targname" ucd="meta.id;src" utype="ssa:Target.Name"><DESCRIPTION>Common name of object observed.</DESCRIPTION></FIELD><FIELD ID="ssa_targetpos" arraysize="2" datatype="double" name="ssa_targetpos" ucd="pos.eq;src" utype="ssa:Target.pos.spoint" xtype="point"><DESCRIPTION>Equatorial (ICRS) position of the target object.</DESCRIPTION></FIELD><FIELD ID="ssa_region" arraysize="*" datatype="double" name="ssa_region" ucd="pos.outline;obs.field" xtype="polygon"><DESCRIPTION>Rough coverage based on location and aperture.</DESCRIPTION></FIELD><FIELD ID="ssa_creator" arraysize="*" datatype="unicodeChar" name="ssa_creator" utype="ssa:DataID.Creator"><DESCRIPTION>Creator of the datasets included here.</DESCRIPTION></FIELD><FIELD ID="ssa_redshift" datatype="float" name="ssa_redshift" ucd="src.redshift" utype="ssa:Target.Redshift"><DESCRIPTION>Redshift of target object</DESCRIPTION></FIELD><FIELD ID="ssa_length" datatype="int" name="ssa_length" utype="ssa:Dataset.Length"><DESCRIPTION>Number of points in the spectrum</DESCRIPTION><VALUES null="-1"></VALUES></FIELD><FIELD ID="ssa_dateObs" datatype="double" name="ssa_dateObs" ref="ts" ucd="time.epoch" unit="d" utype="ssa:Char.TimeAxis.Coverage.Location.Value" xtype="mjd"><DESCRIPTION>Midpoint of exposure (MJD)</DESCRIPTION></FIELD><FIELD ID="accsize" datatype="long" name="accsize" unit="byte" utype="ssa:Access.Size"><DESCRIPTION>Size of the data in bytes</DESCRIPTION><VALUES null="-1"></VALUES></FIELD><DATA><BINAR