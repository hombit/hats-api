<INFO name="QUERY" value="SELECT TOP 10 objid, prefname, prefphytype, ra, dec, uncmaja, zflag, z, zunc, n_crosref, n_notes FROM NEDTAP.objdir WHERE CONTAINS(POINT('J2000', ra, dec), CIRCLE('J2000', 10.68, 41.27, 0.05))=1"/>
