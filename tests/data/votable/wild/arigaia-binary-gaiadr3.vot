</RESOURCE><RESOURCE type="meta" utype="adhoc:service" name="Datalink_GaiaDR3">
<DESCRIPTION>Get all the linked data the specified Gaia-DR3 source ID.</DESCRIPTION>
<PARAM arraysize="51" datatype="char" name="accessURL" ucd="meta.ref.url" value="https://gaia.ari.uni-heidelberg.de/datalink/gaiadr3">
