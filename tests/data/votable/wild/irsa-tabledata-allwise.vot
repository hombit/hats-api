<?xml version="1.0" encoding="utf-8"?>
<VOTABLE version="1.3" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://www.ivoa.net/xml/VOTable/v1.3" xmlns:stc="http://www.ivoa.net/xml/STC/v1.30" xsi:schemaLocation="http://www.ivoa.net/xml/VOTable/v1.3 http://www.ivoa.net/xml/VOTable/v1.3 http://www.ivoa.net/xml/STC/v1.30 http://www.ivoa.net/xml/STC/v1.30">
  <RESOURCE type="results">
    <INFO name="QUERY_STATUS" value="OK"/>
    <TABLE>
      <FIELD name="cntr" datatype="long" ID="col_0" ucd="meta.record">
        <DESCRIPTION>unique entry counter (key) number</DESCRIPTION>
      </FIELD>
      <FIELD name="designation" datatype="char" arraysize="*" ID="col_1" ucd="meta.id;meta.main">
        <DESCRIPTION>WISE source designation</DESCRIPTION>
      </FIELD>
      <FIELD name="ra" datatype="double" ID="col_2" irsa_format="11.7f" precision="F7" ucd="pos.eq.ra;meta.main" unit="deg">
        <DESCRIPTION>right ascension (J2000)</DESCRIPTION>
      </FIELD>
      <FIELD name="dec" datatype="double" ID="col_3" irsa_format="11.7f" precision="F7" ucd="pos.eq.dec;meta.main" unit="deg">
        <DESCRIPTION>declination (J2000)</DESCRIPTION>
      </FIELD>
      <FIELD name="w1mpro" datatype="float" ID="col_4" irsa_format="7.3f" precision="F3" ucd="phot.mag" unit="mag">
        <DESCRIPTION>instrumental profile-fit photometry magnitude, band 1</DESCRIPTION>
      </FIELD>
      <FIELD name="w1sigmpro" datatype="float" ID="col_5" irsa_format="5.3f" precision="F3" ucd="stat.error" unit="mag">
        <DESCRIPTION>instrumental profile-fit photometry flux uncertainty in mag units, band 1</DESCRIPTION>
      </FIELD>
      <FIELD name="w4mpro" datatype="float" ID="col_6" irsa_format="7.3f" precision="F3" ucd="phot.mag" unit="mag">
        <DESCRIPTION>instrumental profile-fit photometry magnitude, band 4</DESCRIPTION>
      </FIELD>
      <FIELD name="w4sigmpro" datatype="float" ID="col_7" irsa_format="5.3f" precision="F3" ucd="stat.error" unit="mag">
        <DESCRIPTION>instrumental profile-fit photometry flux uncertainty in mag units, band 4</DESCRIPTION>
      </FIELD>
      <FIELD name="cc_flags" datatype="char" arraysize="*" ID="col_8" ucd="meta.code">
        <DESCRIPTION>prioritized artifacts affecting the source in each band</DESCRIPTION>
      </FIELD>
      <FIELD name="ext_flg" datatype="long" ID="col_9" ucd="stat.probability">
        <DESCRIPTION>probability that source morphology is not consistent with single PSF</DESCRIPTION>
      </FIELD>
      <FIELD name="nb" datatype="long" ID="col_10" ucd="meta.number;stat.fit.param">
        <DESCRIPTION>number of blend components used in each fit</DESCRIPTION>
      </FIELD>
      <FIELD name="na" datatype="long" ID="col_11" ucd="meta.code">
        <DESCRIPTION>active deblend flag (=1 if actively deblended)</DESCRIPTION>
      </FIELD>
      <FIELD name="ph_qual" datatype="char" arraysize="*" ID="col_12" ucd="meta.code.qual">
        <DESCRIPTION>photometric quality of each band (A=highest, U=upper limit)</DESCRIPTION>
      </FIELD>
      <FIELD name="w1mjdmean" datatype="double" ID="col_13" irsa_format="14.8f" precision="F8" ucd="time.epoch">
        <DESCRIPTION>mean modified Julian Date of frame extractions, band 1</DESCRIPTION>
      </FIELD>
      <FIELD name="pmra" datatype="long" ID="col_14" ucd="pos.pm" unit="mas/yr">
        <DESCRIPTION>Apparent motion in RA</DESCRIPTION>
      </FIELD>
