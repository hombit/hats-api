<?xml version="1.0" encoding="UTF-8"?>
<VOTABLE xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
xsi:noNamespaceSchemaLocation="xmlns:http://www.ivoa.net/xml/VOTable-1.2.xsd" version="1.2">
<RESOURCE type="results">
<DESCRIPTION>DALServer TAP Query</DESCRIPTION>
<INFO name="QUERY_STATUS" value="OK"/>
<INFO name="QUERY" value="SELECT TOP 10 coadd_object_id, ra, dec, mag_auto_g, magerr_auto_g, flags_g, extended_class_coadd, tilename FROM des_dr2.main WHERE ra BETWEEN 10.0 AND 10.02 AND dec BETWEEN -40.02 AND -40.0"/>
<INFO name="INPUT:RESPONSEFORMAT" value="votable"/>
<INFO name="TableRows" value="10"/>
<TABLE>
<FIELD ID="coadd_object_id" name="coadd_object_id" datatype="long" ucd="meta.id;meta.main">
<DESCRIPTION>unique identifier for the coadded objects</DESCRIPTION>
</FIELD>
<FIELD ID="ra" name="ra" datatype="double" ucd="pos.eq.ra;meta.main" unit="degrees">
<DESCRIPTION>right ascension, with quantized precision for indexing (alphawin_j2000 has full precision but not indexed) [degrees]</DESCRIPTION>
</FIELD>
<FIELD ID="dec" name="dec" datatype="double" ucd="pos.eq.dec;meta.main" unit="degrees">
<DESCRIPTION>declination, with quantized precision for indexing (deltawin_j2000 has full precision but not indexed) [degrees]</DESCRIPTION>
</FIELD>
<FIELD ID="mag_auto_g" name="mag_auto_g" datatype="float" unit="mag">
<DESCRIPTION>g-band magnitude estimation, for an elliptical model based on the kron radius [mag]</DESCRIPTION>
</FIELD>
<FIELD ID="magerr_auto_g" name="magerr_auto_g" datatype="float" unit="mag">
<DESCRIPTION>g-band uncertainty in magnitude estimation, for an elliptical model based on the kron radius [mag]</DESCRIPTION>
</FIELD>
<FIELD ID="flags_g" name="flags_g" datatype="short">
<DESCRIPTION>g-band additive flag describing cautionary advice about source extraction process. use less than 4 for well behaved objects</DESCRIPTION>
</FIELD>
<FIELD ID="extended_class_coadd" name="extended_class_coadd" datatype="short">
<DESCRIPTION>0: high confidence stars; 1: candidate stars; 2: mostly galaxies; 3: high confidence galaxies; -9: no data; using sextractor photometry</DESCRIPTION>
</FIELD>
<FIELD ID="tilename" name="tilename" datatype="char" arraysize="1">
<DESCRIPTION>identifier of each one of the tiles on which the survey is gridded</DESCRIPTION>
</FIELD>
