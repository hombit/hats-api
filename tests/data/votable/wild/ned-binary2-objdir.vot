<?xml version="1.0" encoding="utf-8"?>
<VOTABLE version="1.3" xmlns="http://www.ivoa.net/xml/VOTable/v1.3" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.ivoa.net/xml/VOTable/v1.3 http://www.ivoa.net/xml/VOTable/v1.3">
<RESOURCE type="results">
<INFO name="QUERY_STATUS" value="OK"/>
<INFO name="PROVIDER" value="NASA/IPAC Extragalatic Database (NED)">NED VO Table Access Protocol (TAP) Service</INFO>
<INFO name="QUERY" value="SELECT TOP 10 objid, prefname, prefphytype, ra, dec, uncmaja, zflag, z, zunc, n_crosref, n_notes FROM NEDTAP.objdir WHERE CONTAINS(POINT('J2000', ra, dec), CIRCLE('J2000', 10.68, 41.27, 0.05))=1"/>
<TABLE name="result_S1790649036131">
<FIELD datatype="long" name="objid" ucd="meta.id;src">
<DESCRIPTION>Internal identifier for the object in NED</DESCRIPTION>
</FIELD>
<FIELD arraysize="*" datatype="char" name="prefname" ucd="meta.id.cross">
<DESCRIPTION>preferred object name</DESCRIPTION>
</FIELD>
<FIELD arraysize="*" datatype="char" name="prefphytype" ucd="src.class">
<DESCRIPTION>NED preferred object type</DESCRIPTION>
</FIELD>
<FIELD datatype="double" name="ra" ucd="pos.eq.ra" unit="deg">
<DESCRIPTION>RA in decimal degrees of the object Equatorial Coordinate System, J2000.0</DESCRIPTION>
</FIELD>
<FIELD datatype="double" name="dec" ucd="pos.eq.dec" unit="deg">
<DESCRIPTION>DEC in decimal degrees of the object Equatorial Coordinate System, J2000.0</DESCRIPTION>
</FIELD>
<FIELD datatype="double" name="uncmaja" ucd="stat.error;pos.errorEllipse;stat.max" unit="arcsec">
<DESCRIPTION>Uncertainty Ellipse, Semimajor Axis in arcseconds</DESCRIPTION>
</FIELD>
<FIELD arraysize="*" datatype="char" name="zflag" ucd="meta.code;src.redshift">
<DESCRIPTION>Redshift flag</DESCRIPTION>
</FIELD>
<FIELD datatype="double" name="z" ucd="src.redshift">
<DESCRIPTION>Redshift in z.</DESCRIPTION>
</FIELD>
<FIELD datatype="double" name="zunc" ucd="stat.error;src.redshift">
<DESCRIPTION>Redshift Uncertainty</DESCRIPTION>
</FIELD>
<FIELD datatype="int" name="n_crosref" ucd="meta.number">
<DESCRIPTION>Number of references</DESCRIPTION>
</FIELD>
<FIELD datatype="int" name="n_notes" ucd="meta.number">
<DESCRIPTION>Number of notes data frames</DESCRIPTION>
</FIELD>
