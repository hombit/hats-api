  <INFO name="QUERY_STATUS" value="OK">No errors detected in query preprocessing</INFO>
  <TABLE>
   <DESCRIPTION>Query result for:&#xA;SELECT TOP 10 obsid, name, ra, dec, time, end_time, duration, pi_lname, status, data_in_heasarc, public_date FROM xmmmaster WHERE CONTAINS(POINT(&apos;ICRS&apos;, ra, dec), CIRCLE(&apos;ICRS&apos;, 83.63, 22.01, 0.5))=1</DESCRIPTION>
   <FIELD datatype="char" arraysize="*" ucd="meta.id;meta.main" name="obsid" ID="DataLinkID">
    <DESCRIPTION>Unique Observation Identifier</DESCRIPTION>
   </FIELD>
   <FIELD datatype="char" arraysize="*" ucd="meta.id;src" name="name">
    <DESCRIPTION>Target Designation</DESCRIPTION>
   </FIELD>
   <FIELD unit="deg" datatype="double" ucd="pos.eq.ra;meta.main" precision="F5" name="ra">
    <DESCRIPTION>Right Ascension of Target</DESCRIPTION>
   </FIELD>
   <FIELD unit="deg" datatype="double" ucd="pos.eq.dec;meta.main" precision="F5" name="dec">
    <DESCRIPTION>Declination of Target</DESCRIPTION>
   </FIELD>
   <FIELD unit="d" datatype="double" ucd="time.start;obs" name="time">
    <DESCRIPTION>Observation Start Time</DESCRIPTION>
   </FIELD>
   <FIELD unit="d" datatype="double" ucd="time.end;obs" name="end_time">
    <DESCRIPTION>Observation End Time</DESCRIPTION>
   </FIELD>
   <FIELD unit="s" datatype="int" ucd="time.duration;obs" name="duration">
    <DESCRIPTION>Observation On-Time or Duration As Determined by Processing (s)</DESCRIPTION>
    <VALUES null="-2147483648"/>
   </FIELD>
   <FIELD datatype="char" arraysize="*" ucd="meta.id.PI" name="pi_lname">
    <DESCRIPTION>Family Name of Principal Investigator</DESCRIPTION>
   </FIELD>
   <FIELD datatype="char" arraysize="*" name="status">
    <DESCRIPTION>Status of Observation: scheduled, observed, processed, archived</DESCRIPTION>
   </FIELD>
   <FIELD datatype="char" arraysize="*" name="data_in_heasarc">
    <DESCRIPTION>Flag Indicates Whether Dataset Is Available in HEASARC Archive [YN]</DESCRIPTION>
   </FIELD>
   <FIELD unit="d" datatype="int" ucd="time.release" name="public_date">
    <DESCRIPTION>Date That Data Products Become Public</DESCRIPTION>
