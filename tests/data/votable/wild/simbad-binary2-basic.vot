</FIELD>
<FIELD arraysize="1" datatype="char" name="rvz_type">
<DESCRIPTION>Radial velocity / redshift type</DESCRIPTION>
</FIELD>
<FIELD arraysize="*" datatype="char" name="otype" ucd="src.class" utype="mango:Label.text[CT.vocabulary=https://www.ivoa.net/rdf/uat#classification]">
