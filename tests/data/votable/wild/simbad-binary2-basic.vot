<RESOURCE type="results">
<INFO name="QUERY_STATUS" value="OK"/>
<INFO name="PROVIDER" value="CDS">SIMBAD TAP Service</INFO>
<INFO name="QUERY" value="SELECT TOP 12 oid, main_id, ra, dec, coo_err_maj, coo_qual, plx_value, rvz_redshift, rvz_type, otype, nbref, update_date, coo_bibcode FROM basic WHERE ra BETWEEN 10 AND 10.2 AND dec BETWEEN 41 AND 41.5 ORDER BY oid"/>
